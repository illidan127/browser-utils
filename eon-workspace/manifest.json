{
  "manifest_version": 3,
  "name": "Eon Workspace",
  "version": "0.4.1",
  "description": "受 Winger 启发的轻量多窗口管理：命名、切换、发送标签；已命名窗口关最后标签不消失。Inspired by Winger, trimmed essentials.",
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg"
  },
  "permissions": [
    "tabs",
    "storage",
    "contextMenus"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Eon Workspace — 窗口管理",
    "default_popup": "popup.html",
    "default_area": "tabstrip",
    "default_icon": {
      "16": "icon.svg",
      "32": "icon.svg",
      "48": "icon.svg"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "F1"
      },
      "description": "打开 Eon Workspace 面板 / Open popup"
    },
    "switch-next": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "切换到下一个窗口 / Switch to next window"
    },
    "switch-previous": {
      "suggested_key": {
        "default": "Shift+Alt+Q"
      },
      "description": "切换到上一个窗口 / Switch to previous window"
    },
    "send-tab": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "发送标签到窗口 /send / Send tab to window"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{b330646e-a373-4bb9-92aa-9aa3616d40b9}",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
